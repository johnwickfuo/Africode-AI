APP_NAME="Africode Football AI"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=http://localhost

# Kickoffs are stored in UTC and displayed in this timezone.
APP_DISPLAY_TIMEZONE=Africa/Lagos

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=africode_football_ai
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Must exceed the FBref scrape timeout (2h) so a long-running scrape job is
# never handed to a second worker mid-run.
DB_QUEUE_RETRY_AFTER=7800

CACHE_STORE=database
CACHE_PREFIX=

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# --- Africode Football AI ---

# football-data.org v4 (required) — fixtures & results, free tier 10 req/min.
# Register at https://www.football-data.org/client/register
FOOTBALLDATA_TOKEN=

# API-Football / api-sports.io (optional) — historical backfill only.
# Free plan: 100 req/day, 10 req/min, older seasons only.
APIFOOTBALL_ENABLED=false
APIFOOTBALL_KEY=

# Python interpreter used by the FBref scrape and prediction jobs.
PYTHON_BIN=python3

# Best Bet eligibility window (section 7.5 of the spec).
BEST_BET_MIN_PROB=0.62
BEST_BET_MAX_PROB=0.92

# Optional single password protecting the whole app on a public VPS.
APP_ACCESS_PASSWORD=

# Gemini chat assistant (free tier). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Global daily cap on Gemini requests across all users (quota protection).
GEMINI_DAILY_CAP=1000
