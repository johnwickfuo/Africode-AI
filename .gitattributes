* text=auto eol=lf

*.blade.php diff=html
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php

/.github export-ignore
CHANGELOG.md export-ignore
.styleci.yml export-ignore

# Committed build outputs (git-pull deployment): keep them out of language
# stats and collapse their diffs in PRs.
vendor/** linguist-vendored -diff
public/build/** linguist-generated -diff
database/africode.sql linguist-generated
